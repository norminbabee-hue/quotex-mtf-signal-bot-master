# QuoteX MTF Signal Bot - LOCAL SETTINGS
# Fill in ONLY these two values, then save this file.
# Do not share your real token in screenshots or GitHub.

TELEGRAM_BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=PASTE_YOUR_CHAT_ID_HERE

# Live Telegram mode: only one best actionable signal at a time.
TELEGRAM_ACTIONABLE_ONLY=true
TELEGRAM_SEND_PREDICTIONS=false
TELEGRAM_PRE_ENTRY_SECONDS=45
TELEGRAM_MAX_ACTIVE_SIGNALS=1

# MT5 / QuoteX
# Leave empty to use the exact QuoteX whitelist built into the project.
MT5_SYMBOLS=
MT5_POLL_SECONDS=0.25
MT5_HISTORY_COUNT=200
MT5_MAX_TICK_AGE_SECONDS=30
MT5_PATH=
QUOTEX_SERVER_OFFSET_SECONDS=21600
