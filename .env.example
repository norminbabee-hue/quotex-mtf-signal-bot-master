# ============================================================
# QuoteX MTF Signal Bot - local Telegram configuration
# ============================================================
# IMPORTANT:
# 1) Copy this file in VS Code to a NEW file named exactly: .env
# 2) Put your real Telegram BotFather token on TELEGRAM_BOT_TOKEN=
# 3) Put your Telegram chat ID on TELEGRAM_CHAT_ID=
# 4) Save .env in the PROJECT ROOT (same level as .env.example)
# 5) NEVER put the real token/chat ID in GitHub.
#
# This .env.example file is safe to keep in GitHub because it has no secrets.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=PASTE_YOUR_CHAT_ID_HERE

# true = send next-candle prediction messages to Telegram.
# false = send only signals that pass the stricter action gate.
TELEGRAM_SEND_PREDICTIONS=true

# --- MT5 / QuoteX ---
# Keep empty to scan the QuoteX whitelist configured by the project.
# Do NOT add all MT5 symbols here; the bot already filters to QuoteX pairs.
MT5_SYMBOLS=
MT5_POLL_SECONDS=0.25
MT5_HISTORY_COUNT=200
MT5_MAX_TICK_AGE_SECONDS=30
MT5_PATH=
QUOTEX_SERVER_OFFSET_SECONDS=21600
