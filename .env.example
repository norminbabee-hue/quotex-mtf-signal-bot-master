# Telegram Bot settings
# Copy this file to .env and replace the placeholder values.
# NEVER commit your real token or chat ID to GitHub.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# false = send only actionable signals.
# true  = also send prediction-only messages when the action gate rejects them.
TELEGRAM_SEND_PREDICTIONS=false

# MT5 / QuoteX settings
# Leave MT5_SYMBOLS empty to scan every FX currency pair available in MT5.
# Or use a comma-separated allow-list, for example: EURUSD,GBPUSD,USDJPY,AUDUSD
MT5_SYMBOLS=
MT5_POLL_SECONDS=0.25
MT5_HISTORY_COUNT=200
MT5_MAX_TICK_AGE_SECONDS=30
MT5_PATH=
QUOTEX_SERVER_OFFSET_SECONDS=21600
